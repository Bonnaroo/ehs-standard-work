<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>EHS Standard Work</title>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="EHS Std Work">
<meta name="theme-color" content="#1F4E79">
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
<style>
  :root{
    --navy:#1F4E79;
    --safety:#FADBD8;
    --env:#D5F5E3;
    --daily:#D6EAF8;
    --todo:#FFF9C4;
    --gray:#E0E0E0;
    --line:#b0b0b0;
    --blue-text:#0000CC;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;background:#dfe3e6;}
  body{
    font-family:Calibri,"Segoe UI",Arial,sans-serif;
    color:#111;
    padding-bottom:60px;
    -webkit-user-select:none; user-select:none;
  }
  input, textarea { -webkit-user-select:text; user-select:text; }

  #topbar{
    position:sticky; top:0; z-index:50;
    background:var(--navy); color:#fff;
    padding:10px 12px calc(10px + env(safe-area-inset-top)) 12px;
    padding-top:calc(10px + env(safe-area-inset-top));
    text-align:center;
    box-shadow:0 2px 6px rgba(0,0,0,.25);
  }
  #topbar .btnrow{ display:flex; gap:8px; justify-content:center; margin-top:8px; }
  #topbar button{
    padding:8px 12px; border-radius:8px; border:1px solid rgba(255,255,255,.5);
    background:rgba(255,255,255,.12); color:#fff; font-size:12px; font-weight:700;
  }
  #topbar button.primary{ background:#fff; color:var(--navy); border-color:#fff; }

  #bottombar button{
    padding:10px 16px; border-radius:8px; border:1px solid var(--navy);
    background:#fff; color:var(--navy); font-size:13px; font-weight:700;
  }
  #bottombar button.primary{ background:var(--navy); color:#fff; }

  .sheet{ max-width:980px; margin:10px auto; padding:0 8px; }

  table.grid{
    width:100%; border-collapse:collapse; margin-bottom:10px;
    background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.12);
  }
  table.grid.boxed{ border:3px solid var(--navy); }
  table.grid td, table.grid th{
    border:1px solid var(--line); padding:6px 8px; font-size:13px; text-align:left; vertical-align:middle;
  }
  table.grid th{ background:var(--gray); font-weight:700; text-align:center; font-size:11.5px; }
  table.grid .title{
    background:var(--navy); color:#fff; font-size:16px; font-weight:700; text-align:center; padding:10px;
  }
  table.grid .sec{ font-weight:700; text-align:center; font-size:13px; padding:8px; }
  .sec-safety{ background:var(--safety); }
  .sec-env{ background:var(--env); }
  .sec-daily{ background:var(--daily); }
  .sec-todo{ background:var(--todo); }
  .sec-notes{ background:var(--gray); }
  .center{ text-align:center; }
  .note-row{ font-size:10.5px; font-style:italic; color:#666; padding:4px 8px; }
  .label-cell{ font-weight:600; }

  table.grid input[type=date], table.grid input[type=number], table.grid input[type=text]{
    width:100%; border:1px solid #cfd6dc; border-radius:6px; padding:7px 4px; font-size:13px;
    text-align:center; background:#fbfcfd; color:var(--blue-text); font-weight:600; font-family:inherit;
  }
  table.grid .computed{
    text-align:center; font-weight:700; background:#f3f5f7; border-radius:6px; padding:6px 4px;
  }

  .chk{
    width:26px; height:26px; border:2px solid #9aa5ad; border-radius:6px; margin:0 auto;
    display:flex; align-items:center; justify-content:center; cursor:pointer;
    background:#fff; font-size:16px; color:#fff; font-weight:800;
  }
  .chk.done{ background:#2e7d32; border-color:#2e7d32; }
  .chk.done::after{ content:"✓"; }

  .todo-row td{ padding:4px 6px; }
  .todo-cell{ display:flex; align-items:center; gap:8px; }
  .todo-cell input[type=text]{
    flex:1; border:none; border-bottom:1px dashed #cfd6dc; background:transparent;
    text-align:left; color:#111; font-weight:400; padding:6px 2px;
  }
  .todo-cell input[type=text].strike{
    text-decoration:line-through; color:#999; font-style:italic;
  }
  .todo-cell input[type=text]:focus{ outline:none; border-bottom:1px solid var(--navy); }

  textarea.notes{
    width:100%; min-height:80px; border:none; padding:8px; font-size:13px; font-family:inherit;
    resize:vertical; background:transparent;
  }

  .hint{ text-align:center; font-size:10.5px; color:#556; padding:4px 0 2px 0; }

  @media print{
    @page{ size: letter portrait; margin: 0.25in; }
    body{ background:#fff; padding-bottom:0; }
    #topbar, .hint, #bottombar{ display:none !important; }
    html,body{ width:100%; }
    .sheet{ max-width:none; width:100%; margin:0; padding:0; }
    table.grid{ box-shadow:none; margin-bottom:2px; width:100% !important; table-layout:fixed; }
    table.grid td, table.grid th{ padding:2px 4px; font-size:8px; }
    table.grid th{ font-size:7.5px; }
    table.grid .title{ font-size:13px; padding:5px; }
    table.grid .sec{ font-size:9px; padding:2px; }
    .note-row{ font-size:6.5px; }
    table.grid input[type=date], table.grid input[type=number], table.grid input[type=text]{
      border:none; background:transparent; padding:0; font-size:8px;
    }
    .chk{ width:10px; height:10px; border-width:1px; border-radius:2px; font-size:8px; }
    .todo-cell input[type=text]{ font-size:8px; padding:0; }
    textarea.notes{ min-height:14px; font-size:8px; padding:2px; }
  }
</style>
</head>
<body>

<div id="topbar">
  <div style="font-weight:700; font-size:15px;">AHM EHS Representative — Standardized Work</div>
</div>

<div class="sheet" id="sheet"></div>
<div class="hint">Everything here saves automatically on this device — safe to close and reopen.</div>
<div id="bottombar" style="text-align:center; padding:10px;">
  <div class="btnrow" style="display:flex; gap:8px; justify-content:center; flex-wrap:wrap;">
    <button onclick="resetWeek()">Reset Weekly Boxes</button>
    <button onclick="downloadBackup()">Download Backup (JSON)</button>
    <button class="primary" onclick="exportToExcel()">Export to Excel</button>
  </div>
</div>

<script>
// ---------------- data ----------------
const DAILY = [
  ["6:00 AM","Review overnight incidents / Gensuite open items / E-Mail Review"],
  ["6:30 AM","Morning production meeting / EHS updates / Report Safety Startup KPIs"],
  ["7:00 AM","Plant floor walk - Safety observations"],
  ["8:00 AM","Address open safety issues / hazard follow-ups"],
  ["10:00 AM","Documentation / Compliance tracking / Training records"],
  ["2:00 PM","Afternoon plant walk / (2:15) production meeting"],
  ["2:30 PM","E-Mail Review / End of day wrap-up / next day planning"],
];
const WEEKLY_DAYS = ["M","T","W","Th","F"];
const WEEKLY_TASKS = [
  "Global EHS Call","Weekly Safety Focus Communication","Safety Observation Assessment Review",
  "Audits Review","Review Training Matrix / Overdue Items",
  "Review Compliance Calendar","Review GenSuite Open Items","Review Action Register Items",
];
const MONTHLY_WEEKS = ["Wk1","Wk2","Wk3","Wk4"];
const MONTHLY_TASKS = [
  "Gensuite Month End Data Entry","EHS Steering Committee Meeting","Safety Staff Meeting Slides",
  "JHSC Meeting","Green Team Metrics Review","S4 Gap Review",
  "SWP3 & SPCC Monthly Inspection",
  "Energy/Water/Waste KPIs Review",
  "Invoice Review / PO Tracking & RPS Creation","Training calendar review / scheduling",
];
const TODO_ROWS = 6;

// ---------------- storage ----------------
const STORE_KEY = "ehs_std_work_v2";
function loadStore(){ try{ return JSON.parse(localStorage.getItem(STORE_KEY) || "{}"); }catch(e){ return {}; } }
function saveStore(s){ try{ localStorage.setItem(STORE_KEY, JSON.stringify(s)); }catch(e){} }
let store = loadStore();
function setVal(key, val){ store[key] = val; saveStore(store); }
function getVal(key, fallback){ return (key in store) ? store[key] : fallback; }

function daysSince(dateStr){
  if(!dateStr) return "—";
  const d = new Date(dateStr + "T00:00:00");
  if(isNaN(d)) return "—";
  const now = new Date();
  const diff = Math.floor((new Date(now.toDateString()) - new Date(d.toDateString())) / 86400000);
  return diff >= 0 ? diff + " days" : "—";
}
function pct(a, b){
  const av = parseFloat(a), bv = parseFloat(b);
  if(!av || isNaN(av) || isNaN(bv)) return "—";
  return Math.round((bv/av)*100) + "%";
}

// ---------------- build the sheet (screen AND print share this markup) ----------------
function buildSheet(){
  let html = `<table class="grid boxed">
    <tr><td colspan="5" class="sec sec-safety">SAFETY STARTUP KPI (reported daily in morning meeting)</td></tr>
    <tr><td colspan="3" class="label-cell">North Plant &ndash; Last Recordable Injury Date</td>
        <td><input type="date" id="northDate"></td><td class="computed" id="northDays">—</td>
        <td rowspan="2" style="text-align:center;padding:6px;width:34%;"><img src="data:image/png;base64," alt="Dauch" style="width:100%;max-height:70px;object-fit:contain;"></td></tr>
    <tr><td colspan="3" class="label-cell">South Plant &ndash; Last Recordable Injury Date</td>
        <td><input type="date" id="southDate"></td><td class="computed" id="southDays">—</td></tr>
    <tr><th colspan="3">Metric</th><th>Assigned / Goal</th><th>Closed / Current (%)</th><th>Last Week/Month (%)</th></tr>
    <tr><td colspan="3" class="label-cell">Hazards Logged (MTD)</td>
        <td><input type="number" id="hazGoal"></td>
        <td class="center"><input type="number" id="hazCurrent" style="width:60%;display:inline-block;"> <span class="computed" id="hazPct" style="display:inline-block;padding:2px 6px;">—</span></td>
        <td class="center"><input type="number" id="hazLastMonthDone" style="width:40%;display:inline-block;">/<input type="number" id="hazLastMonthGoal" style="width:40%;display:inline-block;"> <span class="computed" id="hazLastMonthPct" style="display:inline-block;padding:2px 6px;">—</span></td></tr>
    <tr><td colspan="3" class="label-cell">Weekly Assessments Closed</td>
        <td><input type="number" id="wkGoal"></td>
        <td class="center"><input type="number" id="wkCurrent" style="width:60%;display:inline-block;"> <span class="computed" id="wkPct" style="display:inline-block;padding:2px 6px;">—</span></td>
        <td class="center"><input type="number" id="wkLastDone" style="width:40%;display:inline-block;">/<input type="number" id="wkLastTotal" style="width:40%;display:inline-block;"> <span class="computed" id="wkLastPct" style="display:inline-block;padding:2px 6px;">—</span></td></tr>
    <tr><td colspan="3" class="label-cell">Monthly Assessments Closed (MTD)</td>
        <td><input type="number" id="moGoal"></td>
        <td class="center"><input type="number" id="moCurrent" style="width:60%;display:inline-block;"> <span class="computed" id="moPct" style="display:inline-block;padding:2px 6px;">—</span></td>
        <td class="center"><input type="number" id="moLastDone" style="width:40%;display:inline-block;">/<input type="number" id="moLastTotal" style="width:40%;display:inline-block;"> <span class="computed" id="moLastPct" style="display:inline-block;padding:2px 6px;">—</span></td></tr>
    <tr><td colspan="6" class="note-row">Blue fields = enter manually each day/week/month. Goal/Current tracks live; Last Week/Month = the prior period's final result for reference. Days-since and % complete calculate automatically.</td></tr>
  </table>`;

  // Environmental
  html += `<table class="grid boxed">
    <tr><td colspan="4" class="sec sec-env">ENVIRONMENTAL (E4) USAGE (per 1,000 parts — updated monthly, from Green Team data)</td></tr>
    <tr><th>Metric</th><th>Latest Month</th><th>YTD Avg</th><th>2025 Target</th></tr>
    <tr><td class="label-cell">Electricity (kWh / part)</td><td><input type="number" step="0.01" id="eleLatest"></td><td><input type="number" step="0.01" id="eleYtd"></td><td><input type="number" step="0.01" id="eleTarget"></td></tr>
    <tr><td class="label-cell">Natural Gas (MMBtu / 1,000 parts)</td><td><input type="number" step="0.01" id="gasLatest"></td><td><input type="number" step="0.01" id="gasYtd"></td><td><input type="number" step="0.01" id="gasTarget"></td></tr>
    <tr><td class="label-cell">Water (gal / 1,000 parts)</td><td><input type="number" id="waterLatest"></td><td><input type="number" id="waterYtd"></td><td><input type="number" id="waterTarget"></td></tr>
    <tr><td class="label-cell">Waste Diversion Rate (%)</td><td><input type="number" step="0.1" id="wasteLatest"></td><td><input type="number" step="0.1" id="wasteYtd"></td><td><input type="text" id="wasteTarget"></td></tr>
    <tr><td colspan="4" class="note-row">Blue fields = update monthly from Green Team / E4 report. Waste 2026 is a baseline year.</td></tr>
  </table>`;

  // Daily
  html += `<table class="grid"><tr><td colspan="2" class="sec sec-daily">DAILY RESPONSIBILITIES</td></tr><tr><th style="width:16%;">Time</th><th>Daily Task</th></tr>`;
  DAILY.forEach(([t,task]) => { html += `<tr><td class="center">${t}</td><td>${task}</td></tr>`; });
  html += `</table>`;

  // Weekly
  html += `<table class="grid"><tr><td colspan="${1+WEEKLY_DAYS.length}" class="sec sec-daily">WEEKLY RESPONSIBILITIES</td></tr>
    <tr><th>Weekly Task</th>${WEEKLY_DAYS.map(d=>`<th>${d}</th>`).join("")}</tr>`;
  WEEKLY_TASKS.forEach((task, ti) => {
    html += `<tr><td>${task}</td>${WEEKLY_DAYS.map((d,ci)=>`<td><div class="chk" data-key="wk_${ti}_${ci}" onclick="toggleChk(this)"></div></td>`).join("")}</tr>`;
  });
  html += `</table>`;

  // Monthly
  html += `<table class="grid"><tr><td colspan="${1+MONTHLY_WEEKS.length}" class="sec sec-env">MONTHLY RESPONSIBILITIES</td></tr>
    <tr><th>Monthly Task</th>${MONTHLY_WEEKS.map(w=>`<th>${w}</th>`).join("")}</tr>`;
  MONTHLY_TASKS.forEach((task, ti) => {
    html += `<tr><td>${task}</td>${MONTHLY_WEEKS.map((w,ci)=>`<td><div class="chk" data-key="mo_${ti}_${ci}" onclick="toggleChk(this)"></div></td>`).join("")}</tr>`;
  });
  html += `</table>`;

  // To-Do
  html += `<table class="grid"><tr><td colspan="2" class="sec sec-todo">TO-DO / TASK TRACKING</td></tr><tr><th>High Priority</th><th>This Week</th></tr>`;
  for(let i=0;i<TODO_ROWS;i++){
    html += `<tr class="todo-row">
      <td><div class="todo-cell"><div class="chk" data-key="todoHigh_${i}_done" onclick="toggleTodoChk(this,'todoHigh_${i}')"></div><input type="text" id="todoHigh_${i}" placeholder="High priority item..." oninput="setVal('todoHigh_${i}', this.value)"></div></td>
      <td><div class="todo-cell"><div class="chk" data-key="todoWeek_${i}_done" onclick="toggleTodoChk(this,'todoWeek_${i}')"></div><input type="text" id="todoWeek_${i}" placeholder="This week..." oninput="setVal('todoWeek_${i}', this.value)"></div></td>
    </tr>`;
  }
  html += `</table>`;

  // Notes
  html += `<table class="grid"><tr><td class="sec sec-notes">NOTES / REMINDERS</td></tr>
    <tr><td><textarea class="notes" id="notesArea" placeholder="Jot anything you need to remember here..."></textarea></td></tr>
  </table>`;

  document.getElementById("sheet").innerHTML = html;
}

// ---------------- checkbox behavior ----------------
function toggleChk(node){
  const key = node.getAttribute("data-key");
  const nowDone = !node.classList.contains("done");
  node.classList.toggle("done", nowDone);
  setVal(key, nowDone);
}

// To-Do checkbox: 1st tap = cross it out (done, struck-through). 2nd tap = clear it out
// entirely (empties the text and unchecks) so the line is ready for a new item.
function toggleTodoChk(node, inputId){
  const key = node.getAttribute("data-key");
  const input = document.getElementById(inputId);
  const wasDone = node.classList.contains("done");
  if(!wasDone){
    node.classList.add("done");
    setVal(key, true);
    input.classList.add("strike");
  } else {
    node.classList.remove("done");
    setVal(key, false);
    input.classList.remove("strike");
    input.value = "";
    setVal(inputId, "");
  }
}

function resetWeek(){
  if(!confirm("Clear all Weekly and Monthly checkboxes? This can't be undone.")) return;
  document.querySelectorAll(".chk[data-key^='wk_'], .chk[data-key^='mo_']").forEach(node => {
    node.classList.remove("done");
    setVal(node.getAttribute("data-key"), false);
  });
}

// ---------------- inputs: persist + calc ----------------
const PERSIST_INPUTS = [
  "northDate","southDate","hazGoal","hazCurrent","hazLastMonthDone","hazLastMonthGoal",
  "wkGoal","wkCurrent","wkLastDone","wkLastTotal","moGoal","moCurrent","moLastDone","moLastTotal",
  "eleLatest","eleYtd","eleTarget","gasLatest","gasYtd","gasTarget",
  "waterLatest","waterYtd","waterTarget","wasteLatest","wasteYtd","wasteTarget",
];
function v(id){ const el = document.getElementById(id); return el ? el.value : ""; }

function recalcAll(){
  document.getElementById("northDays").textContent = daysSince(v("northDate"));
  document.getElementById("southDays").textContent = daysSince(v("southDate"));
  document.getElementById("hazPct").textContent = pct(v("hazGoal"), v("hazCurrent"));
  document.getElementById("hazLastMonthPct").textContent = pct(v("hazLastMonthGoal"), v("hazLastMonthDone"));
  document.getElementById("wkPct").textContent = pct(v("wkGoal"), v("wkCurrent"));
  document.getElementById("wkLastPct").textContent = pct(v("wkLastTotal"), v("wkLastDone"));
  document.getElementById("moPct").textContent = pct(v("moGoal"), v("moCurrent"));
  document.getElementById("moLastPct").textContent = pct(v("moLastTotal"), v("moLastDone"));
}

const DEFAULTS = {
  northDate:"2026-01-02", southDate:"2026-01-01",
  hazGoal:"44", hazCurrent:"31",
  hazLastMonthDone:"38", hazLastMonthGoal:"44", wkGoal:"26", wkCurrent:"7", wkLastDone:"25", wkLastTotal:"26", moGoal:"76", moCurrent:"72", moLastDone:"70", moLastTotal:"76",
  eleLatest:"2.41", eleYtd:"2.35", eleTarget:"2.43",
  gasLatest:"0.01", gasYtd:"0.76", gasTarget:"0.63",
  waterLatest:"515", waterYtd:"497", waterTarget:"600",
  wasteLatest:"15.4", wasteYtd:"14.1", wasteTarget:"Baseline Yr",
};

function initInputs(){
  PERSIST_INPUTS.forEach(id => {
    const el = document.getElementById(id);
    if(!el) return;
    const saved = getVal("input_" + id, null);
    el.value = saved !== null ? saved : (DEFAULTS[id] || "");
    el.addEventListener("input", () => { setVal("input_" + id, el.value); recalcAll(); });
  });

  // checkboxes
  document.querySelectorAll(".chk").forEach(node => {
    const key = node.getAttribute("data-key");
    if(getVal(key, false)) node.classList.add("done");
  });

  // to-do text + strike state
  for(let i=0;i<TODO_ROWS;i++){
    ["todoHigh_"+i, "todoWeek_"+i].forEach(id => {
      const el = document.getElementById(id);
      if(!el) return;
      el.value = getVal(id, "");
      if(getVal(id+"_done", false)) el.classList.add("strike");
    });
  }

  const notes = document.getElementById("notesArea");
  notes.value = getVal("notes", "");
  notes.addEventListener("input", () => setVal("notes", notes.value));
}

// ---------------- export to Excel (.xlsx) — styled to match the original workbook ----------------
function chkOn(prefix, ti, ci){ return !!getVal(`${prefix}_${ti}_${ci}`, false); }

async function exportToExcel(){
  const wb = new ExcelJS.Workbook();
  const ws = wb.addWorksheet("Standard Work");
  ws.columns = [{width:15},{width:12.5},{width:12.5},{width:12.5},{width:12.5},{width:12.5},{width:12.5},{width:12.5}];
  ws.views = [{ showGridLines: false }];

  const NAVY="FF1F4E79", PINK="FFFADBD8", GREEN="FFD5F5E3", BLUE="FFD6EAF8", YELLOW="FFFFF9C4", GRAY="FFE0E0E0";
  const BLUE_TEXT="FF0000CC";
  const thinBorder = {
    top:{style:"thin",color:{argb:"FFB0B0B0"}}, left:{style:"thin",color:{argb:"FFB0B0B0"}},
    bottom:{style:"thin",color:{argb:"FFB0B0B0"}}, right:{style:"thin",color:{argb:"FFB0B0B0"}}
  };

  function cell(addr, value, opts={}){
    const c = ws.getCell(addr);
    if(value !== undefined) c.value = value;
    c.font = Object.assign({name:"Calibri", size:9}, opts.font||{});
    if(opts.fill) c.fill = {type:"pattern", pattern:"solid", fgColor:{argb:opts.fill}};
    c.alignment = Object.assign({vertical:"middle", horizontal: opts.center ? "center":"left", wrapText:true}, opts.alignment||{});
    if(opts.border !== false) c.border = thinBorder;
    if(opts.numFmt) c.numFmt = opts.numFmt;
    return c;
  }
  function mergeLabel(range, value, opts={}){
    ws.mergeCells(range);
    // Apply the value to the anchor cell, but border/fill must be set on EVERY cell in
    // the merged range — otherwise the right/bottom edge of the merge (e.g. column H)
    // has no border and the sheet looks like it's missing its outline down that side.
    const [startAddr, endAddr] = range.split(":");
    const startCell = ws.getCell(startAddr), endCell = ws.getCell(endAddr);
    for(let rr = startCell.row; rr <= endCell.row; rr++){
      for(let cc = startCell.col; cc <= endCell.col; cc++){
        const addr = ws.getCell(rr, cc).address;
        cell(addr, addr === startAddr ? value : undefined, opts);
      }
    }
  }
  const boldFill = (fillColor, size) => ({font:{bold:true, size:size||9}, fill:fillColor, center:true});

  // Title
  mergeLabel("A1:H1", "AHM EHS REPRESENTATIVE - STANDARDIZED WORK", {font:{bold:true,size:14,color:{argb:"FFFFFFFF"}}, fill:NAVY, center:true});
  ws.getRow(1).height = 22;

  // Safety Startup KPI
  mergeLabel("A2:H2", "SAFETY STARTUP KPI  (reported daily in morning meeting)", boldFill(PINK, 11));
  mergeLabel("A3:C3", "North Plant – Last Recordable Injury Date", {font:{bold:true}});
  cell("D3", v("northDate"), {center:true, font:{bold:true, color:{argb:BLUE_TEXT}}});
  cell("E3", daysSince(v("northDate")), {center:true, font:{bold:true}});
  cell("F3", "", {border:false}); cell("G3", "", {border:false}); cell("H3", "", {border:false});
  mergeLabel("A4:C4", "South Plant – Last Recordable Injury Date", {font:{bold:true}});
  cell("D4", v("southDate"), {center:true, font:{bold:true, color:{argb:BLUE_TEXT}}});
  cell("E4", daysSince(v("southDate")), {center:true, font:{bold:true}});
  cell("F4", "", {border:false}); cell("G4", "", {border:false}); cell("H4", "", {border:false});

  try{
    const logoResp = await fetch("data:image/png;base64,");
    const logoBuf = await logoResp.arrayBuffer();
    const logoId = wb.addImage({ buffer: logoBuf, extension: "png" });
    ws.addImage(logoId, { tl: { col: 5, row: 2 }, br: { col: 8, row: 4 }, editAs: "oneCell" });
  }catch(e){}

  mergeLabel("A5:C5", "Metric", boldFill(GRAY));
  cell("D5", "Assigned / Goal", boldFill(GRAY));
  cell("E5", "Closed / Current", boldFill(GRAY));
  cell("F5", "% Complete", boldFill(GRAY));
  cell("G5", "Goal %", boldFill(GRAY));
  cell("H5", "Last Week/Month (%)", boldFill(GRAY));

  mergeLabel("A6:C6", "Hazards Logged (MTD)", {font:{bold:true}});
  cell("D6", Number(v("hazGoal"))||0, {center:true, font:{color:{argb:BLUE_TEXT}}});
  cell("E6", Number(v("hazCurrent"))||0, {center:true, font:{color:{argb:BLUE_TEXT}}});
  cell("F6", pct(v("hazGoal"),v("hazCurrent")), {center:true});
  cell("G6", "100%", {center:true});
  cell("H6", `${v("hazLastMonthDone")||0}/${v("hazLastMonthGoal")||0} (${pct(v("hazLastMonthGoal"),v("hazLastMonthDone"))})`, {center:true, font:{color:{argb:BLUE_TEXT}}});

  mergeLabel("A7:C7", "Weekly Assessments Closed", {font:{bold:true}});
  cell("D7", Number(v("wkGoal"))||0, {center:true, font:{color:{argb:BLUE_TEXT}}});
  cell("E7", Number(v("wkCurrent"))||0, {center:true, font:{color:{argb:BLUE_TEXT}}});
  cell("F7", pct(v("wkGoal"),v("wkCurrent")), {center:true});
  cell("G7", "100%", {center:true});
  cell("H7", `${v("wkLastDone")||0}/${v("wkLastTotal")||0} (${pct(v("wkLastTotal"),v("wkLastDone"))})`, {center:true, font:{color:{argb:BLUE_TEXT}}});

  mergeLabel("A8:C8", "Monthly Assessments Closed (MTD)", {font:{bold:true}});
  cell("D8", Number(v("moGoal"))||0, {center:true, font:{color:{argb:BLUE_TEXT}}});
  cell("E8", Number(v("moCurrent"))||0, {center:true, font:{color:{argb:BLUE_TEXT}}});
  cell("F8", pct(v("moGoal"),v("moCurrent")), {center:true});
  cell("G8", "100%", {center:true});
  cell("H8", `${v("moLastDone")||0}/${v("moLastTotal")||0} (${pct(v("moLastTotal"),v("moLastDone"))})`, {center:true, font:{color:{argb:BLUE_TEXT}}});

  // Environmental — sits directly under Safety KPI, no blank/note rows in between
  mergeLabel("A9:H9", "ENVIRONMENTAL (E4) USAGE  (per 1,000 parts — updated monthly, from Green Team data)", boldFill(GREEN, 11));
  mergeLabel("A10:C10", "Metric", boldFill(GRAY));
  cell("D10", "Latest Month", boldFill(GRAY));
  cell("E10", "YTD Avg", boldFill(GRAY));
  cell("F10", "2025 Target", boldFill(GRAY));
  cell("G10", "", {}); cell("H10", "", {});

  function envRow(r, label, latest, ytd, target, numFmt){
    mergeLabel(`A${r}:C${r}`, label, {font:{bold:true}});
    const num = s => { const n = parseFloat(s); return isNaN(n) ? s : n; };
    cell(`D${r}`, num(latest), {center:true, font:{color:{argb:BLUE_TEXT}}, numFmt});
    cell(`E${r}`, num(ytd), {center:true, font:{color:{argb:BLUE_TEXT}}, numFmt});
    cell(`F${r}`, num(target), {center:true, font:{color:{argb:BLUE_TEXT}}, numFmt});
    cell(`G${r}`, "", {}); cell(`H${r}`, "", {});
  }
  envRow(11, "Electricity (kWh / part)", v("eleLatest"), v("eleYtd"), v("eleTarget"), "0.00");
  envRow(12, "Natural Gas (MMBtu / 1,000 parts)", v("gasLatest"), v("gasYtd"), v("gasTarget"), "0.00");
  envRow(13, "Water (gal / 1,000 parts)", v("waterLatest"), v("waterYtd"), v("waterTarget"), "#,##0");
  envRow(14, "Waste Diversion Rate (%)", v("wasteLatest"), v("wasteYtd"), v("wasteTarget"), null);

  // Daily — sits directly under Environmental, no blank/note rows in between
  mergeLabel("A15:H15", "DAILY RESPONSIBILITIES", boldFill(BLUE, 11));
  cell("A16", "Time", boldFill(GRAY));
  mergeLabel("B16:H16", "Daily Task", boldFill(GRAY));
  let r = 17;
  DAILY.forEach(([t,task]) => {
    cell(`A${r}`, t, {center:true});
    mergeLabel(`B${r}:H${r}`, task, {});
    r++;
  });

  // Weekly
  mergeLabel(`A${r}:H${r}`, "WEEKLY RESPONSIBILITIES", boldFill(BLUE, 11)); r++;
  mergeLabel(`A${r}:C${r}`, "Weekly Task", boldFill(GRAY));
  ["D","E","F","G","H"].forEach((col,i) => cell(`${col}${r}`, WEEKLY_DAYS[i], boldFill(GRAY)));
  r++;
  WEEKLY_TASKS.forEach((task, ti) => {
    mergeLabel(`A${r}:C${r}`, task, {});
    ["D","E","F","G","H"].forEach((col,ci) => cell(`${col}${r}`, chkOn("wk",ti,ci)?"☑":"☐", {center:true}));
    r++;
  });

  // Monthly
  mergeLabel(`A${r}:H${r}`, "MONTHLY RESPONSIBILITIES", boldFill(GREEN, 11)); r++;
  mergeLabel(`A${r}:D${r}`, "Monthly Task", boldFill(GRAY));
  ["E","F","G","H"].forEach((col,i) => cell(`${col}${r}`, MONTHLY_WEEKS[i], boldFill(GRAY)));
  r++;
  MONTHLY_TASKS.forEach((task, ti) => {
    mergeLabel(`A${r}:D${r}`, task, {});
    ["E","F","G","H"].forEach((col,ci) => cell(`${col}${r}`, chkOn("mo",ti,ci)?"☑":"☐", {center:true}));
    r++;
  });

  // To-Do
  mergeLabel(`A${r}:H${r}`, "TO-DO / TASK TRACKING", boldFill(YELLOW, 11)); r++;
  mergeLabel(`A${r}:D${r}`, "High Priority", boldFill(GRAY));
  mergeLabel(`E${r}:H${r}`, "This Week", boldFill(GRAY));
  r++;
  for(let i=0;i<TODO_ROWS;i++){
    const hDone = getVal(`todoHigh_${i}_done`, false), wDone = getVal(`todoWeek_${i}_done`, false);
    const hText = getVal(`todoHigh_${i}`, ""), wText = getVal(`todoWeek_${i}`, "");
    mergeLabel(`A${r}:D${r}`, (hDone?"☑ ":"☐ ")+hText, {});
    mergeLabel(`E${r}:H${r}`, (wDone?"☑ ":"☐ ")+wText, {});
    r++;
  }

  // Notes
  mergeLabel(`A${r}:H${r}`, "NOTES / REMINDERS", boldFill(GRAY, 11)); r++;
  const notesLines = (getVal("notes","")||"").split("\n");
  const linesToWrite = (notesLines.length===0 || (notesLines.length===1 && notesLines[0]==="")) ? ["","","","",""] : notesLines.slice(0,8);
  linesToWrite.forEach(line => { mergeLabel(`A${r}:H${r}`, line, {}); r++; });

  ws.pageSetup = {
    orientation: "portrait", fitToPage: true, fitToWidth: 1, fitToHeight: 1,
    margins: { left:0.25, right:0.25, top:0.25, bottom:0.25, header:0.1, footer:0.1 },
  };

  const buf = await wb.xlsx.writeBuffer();
  const blob = new Blob([buf], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  const today = new Date().toISOString().slice(0,10);
  a.href = url; a.download = `EHS_Standard_Work_${today}.xlsx`;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
}

function downloadBackup(){
  const blob = new Blob([JSON.stringify(store, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  const today = new Date().toISOString().slice(0,10);
  a.href = url; a.download = `EHS_Standard_Work_backup_${today}.json`;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
}

// ---------------- init ----------------
buildSheet();
initInputs();
recalcAll();
</script>

</body>
</html>
